{
  "redirects": [
    {
      "destination": "/engagement",
      "permanent": true,
      "source": "/engagement/"
    },
    {
      "destination": "/type",
      "permanent": true,
      "source": "/type/"
    },
    {
      "destination": "/sportsphere",
      "permanent": true,
      "source": "/sportsphere/"
    },
    {
      "source": "/play/",
      "destination": "/play",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "has": [
        {
          "type": "host",
          "value": "play.yoshik.xyz"
        }
      ],
      "destination": "/assets/:path*"
    },
    {
      "source": "/play/:path*",
      "has": [
        {
          "type": "host",
          "value": "play.yoshik.xyz"
        }
      ],
      "destination": "/play/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "play.yoshik.xyz"
        }
      ],
      "destination": "/play"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "play.yoshik.xyz"
        }
      ],
      "destination": "/play/:path*"
    },
    {
      "destination": "https://val-lake.vercel.app/val",
      "source": "/val"
    },
    {
      "destination": "https://val-lake.vercel.app/val/:path*",
      "source": "/val/:path*"
    }
  ],
  "trailingSlash": false,
  "regions": [
    "bom1"
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://accounts.google.com https://cdn.jsdelivr.net https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; img-src 'self' data: blob: https://i.scdn.co https://*.scdn.co https://*.mzstatic.com https://cdn.discordapp.com https://unpkg.com https://server.arcgisonline.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss://api.lanyard.rest https://api.lanyard.rest https://api.spotify.com https://accounts.google.com; frame-src 'self' https://maps.google.com https://accounts.google.com;"
        }
      ]
    }
  ]
}